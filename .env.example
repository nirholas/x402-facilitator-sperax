# Settlement wallet. Pays gas for settlements and for sponsored Permit2 approvals.
# Fund it with ETH on every enabled network.
FACILITATOR_PRIVATE_KEY=0x

# Networks. Arbitrum One (USDs, USDC) is on by default; Base (USDC) is opt-in.
# Comma-separate several RPC URLs to fail over in order.
ENABLE_ARBITRUM=true
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ENABLE_BASE=false
BASE_RPC_URL=https://mainnet.base.org

# Largest ETH amount (wei) sent to a buyer to cover their one-time Permit2 approve.
MAX_SPONSORED_GAS_WEI=100000000000000
# /ready reports degraded when the signer holds less than this (wei) on any network.
MIN_GAS_BALANCE_WEI=200000000000000
# How long to wait for a transaction receipt before reporting settlement as pending.
CONFIRMATION_TIMEOUT_MS=60000

PORT=3402
HOST=0.0.0.0
CORS_ORIGINS=*
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
LOG_LEVEL=info

# Public demo. Setting DEMO_PAY_TO turns on the paid /demo/usds-snapshot route.
DEMO_PAY_TO=
DEMO_PRICE=0.001
STATS_FROM_BLOCK=506000000
# Base URL shown on /demo; derived from the request when unset.
PUBLIC_URL=
# Published in /openapi.json info.contact.email for registry ownership checks.
CONTACT_EMAIL=
